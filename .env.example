# הטוקן שקיבלת מ-@BotFather בטלגרם
TELEGRAM_BOT_TOKEN=

# מספר הזיהוי שלך בטלגרם. השאר ריק בהפעלה הראשונה: הבוט ישלח לך אותו.
ALLOWED_USER_IDS=

# כתובת אתר הצ'אט
CHAT_URL=https://chabad.ai

# false = רואים את חלון הדפדפן בזמן שהבוט עובד (שימושי לבדיקות)
HEADLESS=true

# --- הגדרות מתקדמות (בדרך כלל לא צריך לגעת) ---
